<section class="auris-section full-width auris-bg-ivory">
  <div class="auris-container">
    <ul class="auris-calendar__list">
      {%- for product in section.settings.products -%}
        {%- liquid
          assign year = product.metafields.auris.year.value
          if year == blank and product.metafields.auris.event_date.value != blank
            assign year = product.metafields.auris.event_date.value | date: '%Y'
          endif
          # The date line under the year comes from the real event date;
          # fall back to the free-text status label only for undated events.
          assign event_date = product.metafields.auris.event_date.value
          if event_date != blank
            assign date_label = event_date | date: '%b %-d'
          else
            assign date_label = product.metafields.auris.status.value
          endif
          assign city = product.metafields.auris.city.value
          assign time = product.metafields.auris.gathering_start_time.value
          # Seats on sale yet? Off means the row offers Register Interest only.
          assign bookable = product.metafields.auris.bookable.value
        -%}

        <li class="auris-calendar__item">
          <div>
            {% if year != blank %}<div class="auris-calendar__year">{{ year }}</div>{% endif %}
            {% if date_label != blank %}<div class="auris-calendar__status">{{ date_label }}</div>{% endif %}
            {% if time != blank %}<div class="auris-calendar__time">{{ time }}</div>{% endif %}
          </div>

          <div>
            <h2 class="auris-calendar__name">{{ product.title }}</h2>
            {% if city != blank %}<div class="auris-calendar__city">{{ city }}</div>{% endif %}
            {% if product.description != blank %}
              <div class="auris-calendar__blurb">{{ product.description }}</div>
            {% endif %}
          </div>

          <div class="auris-calendar__action">
            {% if bookable %}
              {%- assign row_variant = product.selected_or_first_available_variant -%}
              {% if product.available and row_variant %}
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ row_variant.id }}">
                  <button type="submit" class="auris-btn">
                    {{ section.settings.cart_label | default: 'Reserve your seat' }}
                  </button>
                {% endform %}
              {% else %}
                <span class="auris-calendar__price auris-calendar__price--soldout">Sold out</span>
              {% endif %}
            {% endif %}

            {% if section.settings.button_url != blank %}
              {%- comment -%}
                Filled when it stands alone, outlined when Reserve leads — so
                every row has exactly one button carrying primary weight.
              {%- endcomment -%}
              <a href="{{ section.settings.button_url }}" class="auris-btn{% if bookable %} auris-btn--ghost{% endif %}" target="_blank" rel="noopener">
                {{ section.settings.button_label | default: 'Register Interest' }}
              </a>
            {% endif %}

            {% if bookable %}
              <a href="{{ product.url }}" class="auris-btn auris-btn--accent">
                {{ section.settings.learn_more_label | default: 'Learn more' }}
              </a>
            {% endif %}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {% if section.settings.footnote != blank %}
      <p class="auris-calendar__foot">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Auris calendar",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Events",
      "info": "Each product's auris.* metafields supply the year, date, city, etc. Order the events here soonest-first.",
      "limit": 50
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Reserve button label",
      "info": "First button. Adds that row's event to the cart.",
      "default": "Reserve your seat"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Register interest label",
      "default": "Register Interest"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Register interest link"
    },
    {
      "type": "text",
      "id": "learn_more_label",
      "label": "Secondary button label",
      "info": "Links to each event's own page.",
      "default": "Learn more"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Dates and venues confirmed closer to each gathering. Society members are notified first."
    }
  ],
  "presets": [
    {
      "name": "Auris calendar"
    }
  ]
}
{% endschema %}
