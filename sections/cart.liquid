{% comment %}
  Auris cart — /cart page styled to match the theme, with an empty state.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="auris-cart full-width auris-bg-ivory">
  <div class="auris-container">
    <div class="auris-cart__head">
      <h1 class="auris-cart__title">{{ section.settings.heading | default: 'Cart' }}</h1>
    </div>

    {% if cart.item_count == 0 %}
      <div class="auris-cart__empty">
        <p class="auris-cart__empty-text">
          {{ section.settings.empty_text | default: 'Your cart is empty.' }}
        </p>
        <a href="{{ section.settings.empty_link_url | default: routes.root_url }}" class="auris-btn">
          {{ section.settings.empty_link_label | default: 'Explore Auris' }}
        </a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="auris-cart__form">
        <ul class="auris-cart__items">
          {% for item in cart.items %}
            <li class="auris-cart__item{% unless item.image %} auris-cart__item--no-image{% endunless %}">
              {% if item.image %}
                <a href="{{ item.url }}" class="auris-cart__thumb">
                  {%- assign item_alt = item.product.title | escape -%}
                  {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item_alt, widths: '120, 200, 300' }}
                </a>
              {% endif %}

              <div class="auris-cart__info">
                <a href="{{ item.url }}" class="auris-cart__name">{{ item.product.title }}</a>
                {% unless item.variant.title contains 'Default' %}
                  <div class="auris-cart__variant">{{ item.variant.title }}</div>
                {% endunless %}
                {% if item.selling_plan_allocation %}
                  <div class="auris-cart__variant">{{ item.selling_plan_allocation.selling_plan.name }}</div>
                {% endif %}
                <div class="auris-cart__unit">{{ item.final_price | money }}</div>
                <a href="{{ item.url_to_remove }}" class="auris-cart__remove">{{ 'cart.remove' | t }}</a>
              </div>

              <div class="auris-cart__qty">
                <label class="auris-cart__qty-label" for="updates_{{ item.key }}">
                  Seats
                </label>
                <input
                  type="number"
                  id="updates_{{ item.key }}"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                  class="auris-cart__qty-input"
                  data-auris-qty
                  data-key="{{ item.key }}"
                >
              </div>

              <div class="auris-cart__line-price">{{ item.final_line_price | money }}</div>
            </li>
          {% endfor %}
        </ul>

        <div class="auris-cart__footer">
          <div class="auris-cart__subtotal">
            <span class="auris-eyebrow" style="color: var(--carbon); opacity: 0.6;">Subtotal</span>
            <span class="auris-cart__subtotal-value">{{ cart.total_price | money }}</span>
          </div>

          <div class="auris-cart__actions">
            <button type="submit" name="update" class="auris-cart__update">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="auris-btn">{{ 'cart.checkout' | t }}</button>
          </div>

          <p class="auris-cart__note">Taxes and shipping calculated at checkout.</p>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    // Bound once on document so it survives the section being re-rendered
    // below — a listener attached inside the section would be wiped by the
    // first update, and scripts re-inserted via innerHTML never re-execute.
    if (window.aurisCartBound) return;
    window.aurisCartBound = true;

    var SECTION_ID = {{ section.id | json }};
    var CHANGE_URL = {{ routes.cart_change_url | json }};

    document.addEventListener('change', function (event) {
      var input = event.target.closest('[data-auris-qty]');
      if (!input) return;

      var quantity = parseInt(input.value, 10);
      if (isNaN(quantity) || quantity < 0) return;

      var row = input.closest('.auris-cart__item');
      if (row) row.classList.add('is-updating');

      fetch(CHANGE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: input.dataset.key, quantity: quantity, sections: SECTION_ID })
      })
        .then(function (response) { return response.json(); })
        .then(function (cart) {
          // Shopify re-renders the section server-side, so line totals and the
          // subtotal keep Liquid's money formatting rather than a JS guess.
          var markup = cart.sections && cart.sections[SECTION_ID];
          var wrapper = document.getElementById('shopify-section-' + SECTION_ID);
          if (markup && wrapper) {
            var parsed = new DOMParser().parseFromString(markup, 'text/html');
            var fresh = parsed.getElementById('shopify-section-' + SECTION_ID) || parsed.body;
            wrapper.innerHTML = fresh.innerHTML;
          }
          if (typeof cart.item_count === 'number') {
            document.querySelectorAll('.auris-header__cart-count').forEach(function (el) {
              el.textContent = '(' + cart.item_count + ')';
            });
          }
        })
        .catch(function () {
          // Leave the row as-is; the Update button still works as a fallback.
          if (row) row.classList.remove('is-updating');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty cart text",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "empty_link_label",
      "label": "Empty cart button label",
      "default": "Explore Auris"
    },
    {
      "type": "url",
      "id": "empty_link_url",
      "label": "Empty cart button link"
    }
  ]
}
{% endschema %}
